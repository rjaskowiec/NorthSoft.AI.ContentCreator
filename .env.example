# ============================================================
# NorthSoft.AI.ContentCreator — Environment Configuration
# ============================================================
# Copy this file to .dev.vars for local development.
# NEVER commit .dev.vars or any file containing real secrets.
# Production secrets must be set via: npx wrangler secret put <KEY>
# ============================================================

# --- AI Provider Configuration ---
# Primary AI provider API key (e.g., OpenAI, Anthropic, Google)
AI_PROVIDER_API_KEY=your-ai-provider-api-key-here

# AI provider identifier (openai | anthropic | google)
AI_PROVIDER=openai

# AI model for content generation
AI_MODEL_WRITER=gpt-4o

# AI model for quality assurance (must be different inference from writer)
AI_MODEL_QA=gpt-4o

# --- Meta / Facebook Configuration ---
# Facebook Page Access Token (long-lived)
META_PAGE_ACCESS_TOKEN=your-facebook-page-access-token-here

# Facebook Page ID
META_PAGE_ID=your-facebook-page-id-here

# Meta App ID
META_APP_ID=your-meta-app-id-here

# Meta App Secret
META_APP_SECRET=your-meta-app-secret-here

# --- Admin Authentication ---
# Admin panel authentication secret (used for session/JWT signing)
ADMIN_AUTH_SECRET=your-admin-auth-secret-here

# --- Application ---
# Override environment (development | staging | production)
# Normally set via wrangler.jsonc vars, this overrides for local dev
# ENVIRONMENT=development
