{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northsoft-ai-contentcreator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",

  // Cron Triggers (Daily automated research run)
  "triggers": {
    "crons": ["0 8 * * *"]
  },

  // D1 Database bindings
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northsoft-ai-contentcreator-prod",
      "database_id": "902bbe67-adda-4797-af9a-a09ec57d5538",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Workers AI binding (Free AI allocation)
  "ai": {
    "binding": "AI"
  },

  // Worker Previews (for Cloudflare Workers preview deployments)
  "previews": {
    "vars": {
      "ENVIRONMENT": "staging",
      "FACEBOOK_PUBLISH_ENABLED": "false",
      "LOG_LEVEL": "debug"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "northsoft-ai-contentcreator-staging",
        "database_id": "960c64cd-c450-47bc-a0e6-58552aa0d824",
        "migrations_dir": "migrations"
      }
    ],
    "ai": {
      "binding": "AI"
    }
  },

  // Environment-specific overrides
  "env": {
    "staging": {
      "name": "northsoft-ai-contentcreator-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "northsoft-ai-contentcreator-staging",
          "database_id": "960c64cd-c450-47bc-a0e6-58552aa0d824",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "FACEBOOK_PUBLISH_ENABLED": "false",
        "LOG_LEVEL": "debug"
      }
    },
    "production": {
      "name": "northsoft-ai-contentcreator",
      "routes": [
        {
          "pattern": "ai.northsoft.is/*",
          "zone_name": "northsoft.is"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "northsoft-ai-contentcreator-prod",
          "database_id": "902bbe67-adda-4797-af9a-a09ec57d5538",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "FACEBOOK_PUBLISH_ENABLED": "false",
        "LOG_LEVEL": "warn"
      }
    }
  },

  // Default vars (development)
  "vars": {
    "ENVIRONMENT": "development",
    "FACEBOOK_PUBLISH_ENABLED": "false",
    "LOG_LEVEL": "debug"
  }
}
