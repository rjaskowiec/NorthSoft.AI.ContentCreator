{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northsoft-ai-contentcreator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",

  // Cron Triggers (Automated 5-minute publication scheduler check & daily research run)
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // D1 Database bindings
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northsoft-ai-contentcreator-prod",
      "database_id": "902bbe67-adda-4797-af9a-a09ec57d5538",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Workers AI binding (Free AI allocation)
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    { "binding": "IMAGE_BUCKET", "bucket_name": "northsoft-ai-content-images-dev" }
  ],

  // Worker Previews (for Cloudflare Workers preview deployments)
  "previews": {
    "vars": {
      "ENVIRONMENT": "staging",
      "FACEBOOK_PUBLISH_ENABLED": "false",
      "LOG_LEVEL": "debug"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "northsoft-ai-contentcreator-staging",
        "database_id": "960c64cd-c450-47bc-a0e6-58552aa0d824",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      { "binding": "IMAGE_BUCKET", "bucket_name": "northsoft-ai-content-images-staging" }
    ],
    "ai": {
      "binding": "AI"
    }
  },

  // Environment-specific overrides
  "env": {
    "staging": {
      "name": "northsoft-ai-contentcreator-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "northsoft-ai-contentcreator-staging",
          "database_id": "960c64cd-c450-47bc-a0e6-58552aa0d824",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "IMAGE_BUCKET", "bucket_name": "northsoft-ai-content-images-staging" }
      ],
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "FACEBOOK_PUBLISH_ENABLED": "false",
        "LOG_LEVEL": "debug"
      }
    },
    "production": {
      "name": "northsoft-ai-contentcreator",
      "routes": [
        {
          "pattern": "ai.northsoft.is",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "northsoft-ai-contentcreator-prod",
          "database_id": "902bbe67-adda-4797-af9a-a09ec57d5538",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "IMAGE_BUCKET", "bucket_name": "northsoft-ai-content-images" }
      ],
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "ENVIRONMENT": "production",
        "FACEBOOK_PUBLISH_ENABLED": "true",
        "LOG_LEVEL": "warn"
      }
    }
  },

  // Default vars (production)
  "vars": {
    "ENVIRONMENT": "production",
    "FACEBOOK_PUBLISH_ENABLED": "true",
    "LOG_LEVEL": "info"
  }
}
